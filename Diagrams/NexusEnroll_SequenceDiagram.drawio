        <UserObject label="NexusEnroll - Student Course Enrolment" plantUmlId="title_60" plantUmlBaseStyle="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;" plantUmlBaseValue="NexusEnroll - Student Course Enrolment" id="UaWVeLaf3N1_AnQeVW84-112">
          <mxCell parent="UaWVeLaf3N1_AnQeVW84-53" style="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;" vertex="1">
            <mxGeometry height="24" width="283.78000000000003" x="648.1635714285716" y="1110" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nautonumber\nskinparam maxMessageSize 150\n\nactor \&quot;Student / SPA Frontend\&quot; as Client\nparticipant EnrollmentFacade as Facade\nparticipant EnrollmentService as Service\nparticipant PrerequisiteCheckRule as PreReq\nparticipant CapacityCheckRule as Cap\nparticipant TimeConflictCheckRule as Time\nparticipant Course as Course\nparticipant Student as Student\nparticipant Enrollment as Enrollment\nparticipant EnrollmentEventPublisher as Pub\nparticipant NotificationObservers as Obs\n\nClient -&gt; Facade: enroll(studentId, courseId)\nactivate Facade\nnote right of Facade: System retrieves Student\\nand Course objects\n\nFacade -&gt; Service: processEnrollment(student, course)\nactivate Service\n\ngroup Strategy Pattern: Validation Rules Execution\n    Service -&gt; PreReq: validate(student, course)\n    activate PreReq\n    PreReq --&gt; Service: true\n    deactivate PreReq\n\n    Service -&gt; Cap: validate(student, course)\n    activate Cap\n    Cap -&gt; Course: hasAvailableSeat()\n    activate Course\n    Course --&gt; Cap: true\n    deactivate Course\n    Cap --&gt; Service: true\n    deactivate Cap\n\n    Service -&gt; Time: validate(student, course)\n    activate Time\n    Time --&gt; Service: true\n    deactivate Time\nend\n\nalt Validation Fails (Any rule returns false)\n    Service --&gt; Facade: return false\n    Facade --&gt; Client: Show Validation Error\nelse Validation Succeeds\n    note over Service, Enrollment: Core Business Logic &amp; Transaction\n    \n    Service -&gt; Course: enrolledCount + 1\n    activate Course\n    Course --&gt; Service: updated\n    deactivate Course\n\n    Service -&gt; Enrollment ** : &lt;&lt;create&gt;&gt;(student, course)\n    activate Enrollment\n    \n    Service -&gt; Enrollment: updateStatus(\&quot;Enrolled\&quot;)\n    Enrollment --&gt; Service: status updated\n    deactivate Enrollment\n\n    Service -&gt; Student: add to enrolledCourses\n    activate Student\n    Student --&gt; Service: schedule updated\n    deactivate Student\n\n    group Observer Pattern: Event Notification\n        Service -&gt; Pub: publish(EnrollmentEvent)\n        activate Pub\n        Pub -&gt; Obs: update(EnrollmentEvent)\n        activate Obs\n        note right of Obs: AdvisorNotifier or WaitlistNotifier\\nprocesses event via NotificationFactory\n        Obs --&gt; Pub: notification handled\n        deactivate Obs\n        Pub --&gt; Service: publish complete\n        deactivate Pub\n    end\n\n    Service --&gt; Facade: return true\nend\ndeactivate Service\n\nFacade --&gt; Client: Show Success Message\ndeactivate Facade\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="7Nd4KRtbeJ_pRuW3KQpb-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
