        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml NexusEnroll_Seq_Combined\nactor Student\nparticipant \&quot;EnrollmentFacade\&quot; as Facade\nparticipant \&quot;EnrollmentService\&quot; as Service\nparticipant \&quot;ValidationRule\&quot; as Rule\nparticipant \&quot;EnrollmentEventPublisher\&quot; as Publisher\nparticipant \&quot;WaitlistNotifier\&quot; as Notifier\nparticipant \&quot;NotificationFactory\&quot; as Factory\nparticipant \&quot;Notification\&quot; as Notif\nactor Faculty\nparticipant \&quot;GradeSubmission\&quot; as Submission\nactor Administrator\n\n== Enrolment (Strategy) ==\n\nStudent -&gt; Facade: enroll(studentId, courseId)\nFacade -&gt; Service: processEnrollment(student, course)\n\nloop for each rule in validationRules\n  Service -&gt; Rule: validate(student, course)\n  Rule --&gt; Service: valid: boolean\nend\n\nalt all rules valid\n  Service --&gt; Facade: true\n  Facade --&gt; Student: enrollment confirmed\nelse validation failed\n  Service --&gt; Facade: false\n  Facade --&gt; Student: enrollment rejected(reason)\nend\n\n== Drop course to waitlist notification (Observer + Factory Method) ==\n\nStudent -&gt; Service: processDrop(student, course)\nnote right of Service\n  Enrollment status updated,\n  seat freed on Course\nend note\n\nService -&gt; Publisher: publish(courseDroppedEvent)\nPublisher -&gt; Notifier: update(event)\nNotifier -&gt; Factory: createNotification(type)\nFactory --&gt; Notifier: Notification\nNotifier -&gt; Notif: send()\n\n== Grade submission (State) ==\n\nFaculty -&gt; Submission: submit(grade)\nSubmission -&gt; Submission: currentState.submit(this)\nnote right: state: Pending -&gt; Submitted\nSubmission --&gt; Faculty: submitted\n\nalt administrator approves\n  Administrator -&gt; Submission: approve()\n  Submission -&gt; Submission: currentState.approve(this)\n  note right: state stays Submitted (final)\n  Submission --&gt; Administrator: grade recorded\nelse administrator rejects\n  Administrator -&gt; Submission: reject(reason)\n  Submission -&gt; Submission: currentState.reject(this, reason)\n  note right: state: Submitted -&gt; Rejected\n  Submission --&gt; Faculty: notify: resubmit needed\nend\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="7Nd4KRtbeJ_pRuW3KQpb-142">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
