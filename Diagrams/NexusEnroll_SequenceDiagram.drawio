      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle NexusEnroll - Student Course Enrolment\n\nactor Student\n\nparticipant EnrollmentFacade\nparticipant EnrollmentService\nparticipant PrerequisiteCheckRule\nparticipant CapacityCheckRule\nparticipant TimeConflictCheckRule\nparticipant Course\nparticipant EnrollmentEventPublisher\nparticipant WaitlistNotifier\nparticipant AdvisorNotifier\n\nStudent -&gt; EnrollmentFacade: enroll(studentId, courseId)\n\nEnrollmentFacade -&gt; EnrollmentService: processEnrollment(student, course)\n\nactivate EnrollmentService\n\nEnrollmentService -&gt; PrerequisiteCheckRule: validate(student, course)\nPrerequisiteCheckRule --&gt; EnrollmentService: true / false\n\nalt Prerequisite check fails\n    EnrollmentService --&gt; EnrollmentFacade: false\n    EnrollmentFacade --&gt; Student: Enrollment rejected\\n(Prerequisite not satisfied)\n\nelse Prerequisite valid\n\n    EnrollmentService -&gt; CapacityCheckRule: validate(student, course)\n    CapacityCheckRule -&gt; Course: hasAvailableSeat()\n    Course --&gt; CapacityCheckRule: true / false\n    CapacityCheckRule --&gt; EnrollmentService: true / false\n\n    alt Course is full\n        EnrollmentService --&gt; EnrollmentFacade: false\n        EnrollmentFacade --&gt; Student: Enrollment rejected\\n(Course is full)\n\n    else Capacity available\n\n        EnrollmentService -&gt; TimeConflictCheckRule: validate(student, course)\n        TimeConflictCheckRule --&gt; EnrollmentService: true / false\n\n        alt Time conflict exists\n            EnrollmentService --&gt; EnrollmentFacade: false\n            EnrollmentFacade --&gt; Student: Enrollment rejected\\n(Time conflict)\n\n        else All validation successful\n\n            EnrollmentService -&gt; Course: hasAvailableSeat()\n            Course --&gt; EnrollmentService: true\n\n            EnrollmentService -&gt; EnrollmentService: Create Enrollment\n            EnrollmentService -&gt; Course: Increment enrolledCount\n            EnrollmentService -&gt; Student: Update enrolledCourses\n\n            EnrollmentService -&gt; EnrollmentEventPublisher: publish(EnrollmentEvent)\n\n            activate EnrollmentEventPublisher\n\n            EnrollmentEventPublisher -&gt; WaitlistNotifier: update(event)\n            WaitlistNotifier --&gt; EnrollmentEventPublisher: notification handled\n\n            EnrollmentEventPublisher -&gt; AdvisorNotifier: update(event)\n            AdvisorNotifier --&gt; EnrollmentEventPublisher: notification handled\n\n            deactivate EnrollmentEventPublisher\n\n            EnrollmentService --&gt; EnrollmentFacade: true\n            deactivate EnrollmentService\n\n            EnrollmentFacade --&gt; Student: Enrollment confirmed\n\n        end\n    end\nend\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="UaWVeLaf3N1_AnQeVW84-53">
